{"id": 696826, "type": 2, "name": "Ever Behind the Sunset", "name_cn": "", "infobox": "{{Infobox animanga/Anime\r\n|中文名= \r\n|别名={\r\n}\r\n|上映年度= 2026年4月1日\r\n|片长= 8分钟\r\n|官方网站= \r\n|链接={\r\n}\r\n|其他= \r\n|Copyright= \r\n|导演= Jason Mitcham\r\n|剪辑= Jason Mitcham\r\n|音响= Jason Mitcham\r\n|地区= 美国\r\n|话数= 1\r\n}}", "platform": 0, "summary": "A hand-painted stop-motion elegy that traces the erasure of a family home by eminent domain, accompanied by a soundscape drawn from archival family VHS recordings.", "nsfw": false, "tags": [{"name": "短片", "count": 1}, {"name": "美国", "count": 1}, {"name": "Short", "count": 1}, {"name": "物质", "count": 1}, {"name": "2026", "count": 1}], "meta_tags": ["短片", "美国"], "score": 5, "score_details": {"1": 0, "2": 0, "3": 0, "4": 0, "5": 1, "6": 0, "7": 0, "8": 0, "9": 0, "10": 0}, "rank": 0, "date": "2026-04-01", "favorite": {"wish": 0, "done": 2, "doing": 0, "on_hold": 0, "dropped": 0}, "series": false}
